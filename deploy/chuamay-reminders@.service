[Unit]
Description=Chua May family reminders (%i)
After=network-online.target

[Service]
Type=oneshot
User=chuamay
Group=chuamay
EnvironmentFile=/etc/chuamay/%i.env
WorkingDirectory=/opt/chuamay/%i/current/server
ExecStart=/usr/bin/node reminders.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/chuamay/%i
