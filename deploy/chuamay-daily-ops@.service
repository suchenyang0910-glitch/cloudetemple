[Unit]
Description=Chua May daily operations summary (%i)
After=chuamay-api@%i.service network-online.target

[Service]
Type=oneshot
User=chuamay
Group=chuamay
UMask=0077
EnvironmentFile=/etc/chuamay/%i.env
WorkingDirectory=/opt/chuamay/%i/current/server
ExecStart=/opt/chuamay/runtime/bin/node daily-ops.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/chuamay/%i
