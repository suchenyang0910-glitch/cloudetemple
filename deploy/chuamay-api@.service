[Unit]
Description=Chua May API (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chuamay
Group=chuamay
EnvironmentFile=/etc/chuamay/%i.env
WorkingDirectory=/opt/chuamay/%i/current/server
ExecStart=/opt/chuamay/runtime/bin/node index.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chuamay/%i
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=4096
MemoryMax=192M
CPUQuota=25%

[Install]
WantedBy=multi-user.target
