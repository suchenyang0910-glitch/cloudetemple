[Unit]
Description=Cloud Temple private access log receiver
After=local-fs.target

[Service]
UMask=0077
LogsDirectory=chuamay-web
LogsDirectoryMode=0700
ExecStart=/usr/bin/python3 -I /opt/chuamay/nginx-production/image-log-receiver.py
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/chuamay/nginx-production/sites
[Install]
WantedBy=multi-user.target
