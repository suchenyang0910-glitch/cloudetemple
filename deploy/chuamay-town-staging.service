[Unit]
Description=Chua May staging town realtime (independent candidate)
After=network-online.target

[Service]
Type=simple
User=chuamay
Group=chuamay
WorkingDirectory=/opt/chuamay/staging/current/server
Environment=CHUAMAY_ENV=staging
Environment=TOWN_REALTIME_ENABLED=1
Environment=TOWN_DB_PATH=/var/lib/chuamay/staging/api.sqlite
ExecStart=/opt/chuamay/runtime/bin/node --max-old-space-size=160 town-process.mjs
Restart=on-failure
RestartSec=10
MemoryMax=300000000
MemorySwapMax=0
CPUQuota=50%
TasksMax=32
LimitNOFILE=512
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chuamay/staging
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
